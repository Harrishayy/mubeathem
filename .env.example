# ── Mubit (required for live AI; without it the server runs on the offline rules engine) ──
MUBIT_API_KEY=
MUBIT_BASE_URL=https://api.mubit.ai/openai/v1
# Cheap models served by the Mubit starter credit. Fast tasks use MODEL_FAST, writing tasks MODEL_WRITE.
CUE_MODEL_FAST=gpt-4o-mini
CUE_MODEL_WRITE=gpt-4.1-mini
# Max model calls in flight at once (starter credit has a per-project cap)
CUE_MUBIT_CONCURRENCY=4
CUE_MUBIT_TIMEOUT_MS=12000
# full = Mubit keeps request+answer (needed for adapter training); metadata = keep only the call's record
# (metadata also keeps no request/answer bodies in Cue's own trace store)
CUE_MUBIT_RECORD=full
# Local trace of every Mubit call (GET /api/traces, /api/insights, /api/traces/export)
# Days to keep traces, pruned on boot (0 = keep forever)
CUE_TRACE_RETENTION_DAYS=0
# Per-field cap on stored input/output JSON in bytes; longer bodies are cut and marked truncated
CUE_TRACE_MAX_BODY_BYTES=65536

# ── The live path ──
# layered = rules read + instant card, refined by Mubit (below). live = one streamed live_cue call
# through Mubit per prospect turn: reads the moment and writes the line, no rules read (nickmain, Modal).
CUE_PIPELINE=layered
# live_cue's provider through Mubit: gemini (Mubit's Gemini route) or openai (Responses API), and model
CUE_LIVE_PROVIDER=gemini
CUE_LIVE_MODEL=gemini-3.8-flash
# Deadline for one live_cue call (ms)
CUE_LIVE_BUDGET_MS=4000
# 1 = a line the rep improvised on a call that went well joins the playbook straight away (policy-checked)
CUE_AUTO_ACTIVATE=0

# ── Live latency layers for CUE_PIPELINE=layered (architecture.md §5.3, docs/perf/latency.md) ──
# Show a card the moment the prospect stops (rules read + playbook line, or a standby line Mubit wrote
# ahead), then refine it in place with Mubit. 0 = wait for Mubit before showing anything.
CUE_INSTANT_CARD=1
# Start the turn on an interim transcript that looks finished, before the transcriber's final
CUE_EARLY_TRIGGER=1
# Also start Mubit's read/write on that early trigger (one run per utterance; restarts only if the moment changes)
CUE_EARLY_MUBIT=1
# Unchanged-interim silence (ms) that ends an unpunctuated sentence (Web Speech); punctuated interims end at once
CUE_ENDPOINT_PAUSE_MS=250
# A refined card may replace the instant one until this long after the final (never once the rep speaks or acts)
CUE_REFINE_WINDOW_MS=500
# Predicted next moments Mubit pre-writes lines for while the rep talks (0-3; each is one write_line call)
CUE_STANDBY=2
# Open connections to Mubit when the prospect starts talking (GET /models, no model call)
CUE_WARM_MUBIT=1

# ── Trellus Call Data API (optional; Settings → Integrations → API in Trellus) ──
TRELLUS_API_KEY=
TRELLUS_TEAM_ID=
# Poll Trellus for dispositions of finished calls (seconds; 0 disables)
TRELLUS_POLL_SECONDS=60

# ── Optional providers ──
# Pre-call research for the brief. Set either or both; they run in parallel and are merged with citations.
EXA_API_KEY=
VALYU_API_KEY=
# Per-provider timeout, and how long findings for the same person are reused (0 = no cache)
CUE_RESEARCH_TIMEOUT_MS=6000
CUE_RESEARCH_CACHE_MINUTES=720
# Streaming speech-to-text for the prospect's tab audio in the extension (server issues short-lived tokens)
DEEPGRAM_API_KEY=
# api.deepgram.com, or api.eu.deepgram.com to keep audio in the EU (closer to UK reps)
DEEPGRAM_HOST=api.deepgram.com
# Lifetime of the temporary STT tokens handed to the extension (seconds, max 3600)
CUE_STT_TTL_SECONDS=60
# Self-hosted Banyan Sapling endpoint (POST {claim, policy, evidence}); empty → Mubit check_claim task
SAPLING_URL=

# ── Server ──
CUE_PORT=8787
# Store location; keep outside the repo
CUE_DB_PATH=~/.cue/cue.db
# Comma-separated origins allowed to call the API (the web app and the extension)
CUE_ALLOWED_ORIGINS=http://localhost:5173,chrome-extension://*
# Shared secret the clients send as x-cue-token (empty = no auth, local dev only)
CUE_API_TOKEN=
