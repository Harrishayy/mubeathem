MUBIT_API_KEY=
# MUBIT_BASE_URL=https://api.mubit.ai/openai/v1   # use the one your console Connect page shows
# STEWARD_MODEL=gpt-6-luna
# STEWARD_TEMPERATURE=0

# Banyan Sapling. Unset, safety checks run on the stand-in through Mubit.
# SAPLING_URL=http://127.0.0.1:8765             # sapling/serve.py on the DGX, through an SSH tunnel
# SAPLING_URL=https://<workspace>--steward-sapling.<region>.modal.run   # deploy/modal/sapling.py
# SAPLING_TOKEN=                                 # required by the Modal deployment; any long random value

# The team's Modal token, used only through deploy/modal/team.py.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# Console
# STEWARD_READ_ONLY=1      # refuse every POST/DELETE: set on any console other people can reach
