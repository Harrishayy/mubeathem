{
  "name": "cue",
  "private": true,
  "description": "Cue: live cold-call suggestions that learn what books meetings, built on Mubit",
  "packageManager": "pnpm@10.26.1",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "pnpm --filter @cue/server dev",
    "dev:web": "pnpm --filter @cue/web dev",
    "dev:ext": "pnpm --filter @cue/extension dev",
    "build": "pnpm -r --if-present build",
    "build:ext": "pnpm --filter @cue/extension build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:live": "MUBIT_LIVE=1 pnpm --filter @cue/mubit test:live",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "seed:mubit": "pnpm --filter @cue/server seed",
    "trellus:check": "pnpm --filter @cue/trellus check"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
