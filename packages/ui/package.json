{
  "name": "@cue/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens/tokens.css",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "dev": "vite --config gallery/vite.config.ts",
    "build": "vite build --config gallery/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "docs": "tsx scripts/build-docs.tsx",
    "tokens:moments": "node scripts/moments.mjs"
  },
  "dependencies": {
    "@cue/core": "workspace:*",
    "motion": "^14.6.0"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "4.23.15",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
